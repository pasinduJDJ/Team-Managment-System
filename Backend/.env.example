# ================================================================
# BMV OLD BOYS DIGITAL DIARY — BACKEND CONFIGURATION TEMPLATE
# ================================================================
# Keep all values blank until your Supabase project, frontend domain,
# administrator account, and Google Form/Sheet are ready.
#
# Never put SUPABASE_SERVICE_ROLE_KEY or GOOGLE_WEBHOOK_SECRET inside
# the Angular frontend.
# ================================================================

# --- Supabase project ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Browser origins allowed to call admin-api ---
# Comma-separated. Example:
# ALLOWED_ORIGINS=https://diary.example.com,http://localhost:4200
ALLOWED_ORIGINS=

# --- Google Form / Google Sheet webhook ---
# Create a long random secret and use the same value in Apps Script.
GOOGLE_WEBHOOK_SECRET=

# Exact Google Sheet response-column headings.
# These must match row 1 of the Form Responses sheet.
GOOGLE_FIELD_FULL_NAME=
GOOGLE_FIELD_BATCH=
GOOGLE_FIELD_ADMISSION_NUMBER=
GOOGLE_FIELD_MOBILE=
GOOGLE_FIELD_WHATSAPP=
GOOGLE_FIELD_EMAIL=
GOOGLE_FIELD_PROFESSION=
GOOGLE_FIELD_COMPANY=
GOOGLE_FIELD_CITY=
GOOGLE_FIELD_COUNTRY=
GOOGLE_FIELD_LOCATION=
GOOGLE_FIELD_ADDRESS=
GOOGLE_FIELD_NOTES=
GOOGLE_FIELD_CONSENT=

# --- Initial Super Admin ---
# These are used only as setup references. The migration does not create
# an Auth user automatically.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_AUTH_USER_ID=
